      "id": "photometry",
      "type": "photometry",
      "chapter": "measurement",
      "title": "一个光斑的净积分怎样得到",
      "identity": "实验3 · 第125帧 · 6.77 V · 22光斑、88通道",
      "steps": [
        {
          "id": "photometry.input",
